---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import InfiniteCarousel from "./InfiniteCarousel.svelte";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <!-- Mobile infinite carousel -->
  <div class="sm:hidden">
    <InfiniteCarousel projects={projects} client:load />
  </div>

  <!-- Desktop stacked cards -->
  <div class="hidden sm:block">
    {
      projects.map(
        (
          {
            name,
            summary,
            image,
            linkPreview,
            linkSource,
            linkWriteup,
            collaborators,
            languages,
          },
          index,
        ) => {
          const top = 82 + Math.min(index, 2) * 28;
          return (
            <div
              style={`top: ${top}px;`}
              class="sticky mb-12 border-2 border-white bg-black"
            >
              <div class="relative z-[1] grid w-full grid-rows-2 bg-[#f5f5f5] sm:h-[36rem] sm:grid-cols-2 sm:grid-rows-1">
                <div class="flex flex-col border-b-2 border-white px-6 pt-8 pb-6 sm:border-r-2 sm:border-b-0 sm:p-10">
                  <p class="mb-8 text-xs font-bold tracking-[0.16em] text-neutral uppercase">
                    Project / {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3 class="mb-5 font-serif text-3xl font-bold tracking-tight text-primary md:text-4xl">
                    {name}
                  </h3>
                  <p class="text-base leading-relaxed text-neutral">
                    {summary}
                  </p>
                  <div class="flex flex-wrap gap-4 pt-8 text-sm font-bold tracking-[0.08em] text-white uppercase">
                    {linkSource !== "/" && (
                      <a
                        href={linkSource}
                        target="_blank"
                        class="border-b border-white pb-1 whitespace-nowrap hover:text-primary"
                      >
                        Source
                      </a>
                    )}
                    {linkPreview !== "/" && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        class="border-b border-white pb-1 whitespace-nowrap hover:text-primary"
                      >
                        Live Site
                      </a>
                    )}
                    {linkWriteup !== "/" && (
                      <a
                        href={linkWriteup}
                        target="_blank"
                        class="border-b border-white pb-1 whitespace-nowrap hover:text-primary"
                      >
                        Writeup
                      </a>
                    )}
                  </div>
                  {languages && languages.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-3 border-t border-white/20 pt-5">
                      {languages.map(
                        ({ icon, name: langName, languageLink }) => {
                          const isUrl =
                            icon.startsWith("http://") ||
                            icon.startsWith("https://");
                          return languageLink ? (
                            <a
                              href={languageLink}
                              target="_blank"
                              class="group"
                              title={langName}
                            >
                              {isUrl ? (
                                <img
                                  src={icon}
                                  alt={langName}
                                  class="h-7 w-7 grayscale transition hover:grayscale-0"
                                />
                              ) : (
                                <i
                                  class={`${icon} text-2xl grayscale transition hover:grayscale-0`}
                                />
                              )}
                            </a>
                          ) : (
                            <div title={langName}>
                              {isUrl ? (
                                <img
                                  src={icon}
                                  alt={langName}
                                  class="h-7 w-7 grayscale"
                                />
                              ) : (
                                <i class={`${icon} text-2xl grayscale`} />
                              )}
                            </div>
                          );
                        },
                      )}
                    </div>
                  )}
                  {collaborators && collaborators.length > 0 && (
                    <div class="mt-auto pt-6">
                      <p class="mb-3 text-xs font-bold tracking-[0.12em] text-neutral uppercase">
                        Collaborators
                      </p>
                      <div class="flex gap-2">
                        {collaborators.map(
                          ({
                            name: collabName,
                            image: collabImage,
                            profileLink,
                          }) =>
                            profileLink ? (
                              <a
                                href={profileLink}
                                target="_blank"
                                class="group relative"
                                title={collabName}
                              >
                                <Image
                                  src={collabImage}
                                  alt={collabName}
                                  width="40"
                                  height="40"
                                  class="h-10 w-10 border border-white object-cover grayscale transition group-hover:grayscale-0"
                                />
                              </a>
                            ) : (
                              <div class="relative" title={collabName}>
                                <Image
                                  src={collabImage}
                                  alt={collabName}
                                  width="40"
                                  height="40"
                                  class="h-10 w-10 border border-white object-cover grayscale"
                                />
                              </div>
                            ),
                        )}
                      </div>
                    </div>
                  )}
                </div>
                <div class="flex items-end justify-end overflow-hidden bg-black p-3">
                  <Image
                    class="h-full w-full border border-white object-cover object-center grayscale transition duration-500 hover:grayscale-0 sm:h-[88%]"
                    src={image}
                    alt={name}
                    width="1000"
                    height="483"
                  />
                </div>
              </div>
            </div>
          );
        },
      )
    }
  </div>
</Section>
