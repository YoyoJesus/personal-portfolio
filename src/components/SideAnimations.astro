---
// Swiss-inspired background grid and geometric accent.
---

<div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
  <div class="bg-grid mx-auto h-full max-w-6xl border-x border-black/5"></div>
  <div class="absolute top-[38vh] right-0 hidden h-24 w-6 bg-primary lg:block">
  </div>
</div>

<style>
  .bg-grid {
    background-image: linear-gradient(
      to right,
      rgb(17 17 17 / 0.035) 1px,
      transparent 1px
    );
    background-size: calc(100% / 12) 100%;
  }
</style>
