---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="relative z-10 mx-auto grid max-w-6xl grid-cols-12 gap-4 border-t border-white bg-black px-5 py-10 text-white sm:px-8"
>
  <p
    class="col-span-12 text-xs font-bold tracking-[0.16em] uppercase md:col-span-4"
  >
    {author} / {currentYear}
  </p>
  <ul
    class="col-span-12 grid grid-cols-2 gap-px bg-white md:col-span-8 md:grid-cols-4"
  >
    {
      socialLinks.map(({ text, href }) => (
        <li class="bg-black">
          <a
            href={href}
            target="_blank"
            class="block px-4 py-4 text-xs font-bold tracking-[0.12em] uppercase transition-colors hover:bg-primary"
          >
            {text} ↗
          </a>
        </li>
      ))
    }
  </ul>
</footer>
