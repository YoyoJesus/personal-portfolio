---
import type { HeroProps } from "@types";
import ContactForm from "./ContactForm.astro";
type Props = HeroProps;

const { name, specialty, summary, resume, blog } = Astro.props;
---

<section
  class="grid min-h-[calc(100vh-73px)] grid-cols-12 content-center gap-x-4 gap-y-10 py-20 md:py-28"
  id="hero"
>
  <div
    class="col-span-12 flex items-center gap-4 md:col-span-10 md:col-start-3"
  >
    <span class="h-3 w-3 bg-primary"></span>
    <p class="text-xs font-bold tracking-[0.18em] text-neutral uppercase">
      Portfolio / 2026
    </p>
  </div>

  <h1
    class="col-span-12 font-serif text-[clamp(4.2rem,12vw,9.5rem)] leading-[0.82] font-bold tracking-[-0.065em] text-white"
  >
    {name}
  </h1>

  <div class="col-span-12 grid grid-cols-10 gap-4 md:col-start-3">
    <p
      class="col-span-10 font-serif text-3xl leading-tight font-bold tracking-tighter text-primary md:col-span-6 md:text-5xl"
    >
      {specialty}
    </p>
    <p
      class="col-span-10 max-w-2xl text-base leading-relaxed text-neutral md:col-span-7 md:col-start-4 md:text-lg"
    >
      {summary}
    </p>
  </div>

  <div class="col-span-12 flex flex-wrap gap-3 md:col-span-10 md:col-start-3">
    <button
      id="open-contact-form"
      class="cursor-pointer border border-primary bg-primary px-6 py-4 text-sm font-bold tracking-[0.1em] text-[#fff] uppercase transition-colors hover:bg-white hover:text-primary"
    >
      Get in touch
    </button>
    <a
      class="border border-white px-6 py-4 text-sm font-bold tracking-[0.1em] text-white uppercase transition-colors hover:bg-white hover:text-black"
      href={resume}
      target="_blank">View résumé ↗</a
    >
    <a
      class="border border-white px-6 py-4 text-sm font-bold tracking-[0.1em] text-white uppercase transition-colors hover:bg-white hover:text-black"
      href={blog}
      target="_blank">Read blog ↗</a
    >
  </div>
</section>

<ContactForm />
