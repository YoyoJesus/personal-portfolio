---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="About Me" href="about">
  <div class="grid grid-cols-10 gap-4 border-t border-white pt-10 md:pt-14">
    <p
      class="col-span-10 text-xl leading-relaxed text-neutral md:col-span-6 md:text-2xl"
    >
      {description}
    </p>
    <figure
      class="col-span-8 col-start-3 mt-8 md:col-span-3 md:col-start-8 md:mt-0"
    >
      <div class="relative border border-white bg-[#f5f5f5] p-3">
        <span class="absolute -top-3 -left-3 h-12 w-12 bg-primary"></span>
        <Image
          class="relative aspect-square w-full object-cover grayscale"
          src={image}
          width="360"
          height="360"
          alt={name}
        />
      </div>
      <figcaption
        class="mt-3 text-xs font-bold tracking-[0.14em] text-neutral uppercase"
      >
        Austin Sternberg / Ohio, USA
      </figcaption>
    </figure>
  </div>
</Section>
