---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  <div class="border-t border-white">
    {
      experience.map(
        (
          {
            company,
            position,
            startDate,
            workType,
            endDate,
            summary,
            previousPositions,
          },
          index,
        ) => (
          <article class="grid grid-cols-10 gap-x-4 gap-y-6 border-b border-white py-10 md:py-14">
            <div class="col-span-10 md:col-span-3">
              <p class="mb-5 text-xs font-bold tracking-[0.16em] text-primary uppercase">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3 class="font-serif text-2xl font-bold tracking-tight text-white">
                {company}
              </h3>
            </div>
            <div class="col-span-10 md:col-span-7">
              <h4 class="mb-2 font-serif text-2xl font-bold text-primary md:text-3xl">
                {position}
              </h4>
              <div class="mb-7 flex flex-wrap gap-x-5 gap-y-1 text-sm text-neutral">
                <span>
                  {startDate} — {endDate}
                </span>
                <span class="tracking-[0.12em] uppercase">{workType}</span>
              </div>
              {Array.isArray(summary) ? (
                <ul class="space-y-3">
                  {summary.map((log) => (
                    <li class="grid grid-cols-[1.25rem_1fr] text-base leading-relaxed text-neutral before:font-bold before:text-primary before:content-['→']">
                      {log}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-base leading-relaxed text-neutral">{summary}</p>
              )}
              {previousPositions && previousPositions.length > 0 && (
                <div class="mt-8 border-l-4 border-primary pl-5">
                  <p class="mb-3 text-xs font-bold tracking-[0.16em] text-neutral uppercase">
                    Previously
                  </p>
                  <ul>
                    {previousPositions.map((prev) => (
                      <li class="mb-2 flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
                        <span class="font-bold text-white">
                          {prev.position}
                        </span>
                        <span class="text-sm text-neutral">
                          {prev.startDate} — {prev.endDate}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ),
      )
    }
  </div>
</Section>
